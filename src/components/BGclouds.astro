---
import { Image } from 'astro:assets';
import bgcloudsImg from '../assets/bgclouds5.png';
---

<div class="bgcloud-wrap">
  <Image src={bgcloudsImg} alt="BGclouds"/>
</div>

<style>
  .bgcloud-wrap {
    position: absolute;
    top: -20vh;
    width: 100vw;
    height: 93vh;
    z-index: 3;
    overflow: hidden;
  }

  .bgcloud-wrap img {
    width: 103%;
    height: 100%;
    object-fit: fill;
  }
</style>