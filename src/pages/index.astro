---
import MainLayout from '../layouts/MainLayout.astro';
import ParticleBG from '../components/ParticleBG.astro';
import Andy from '../components/Andy.astro';
import BGclouds from '../components/BGclouds.astro';
import SectionIntro from '../components/SectionIntro.astro';
// import IntroStars from '../components/IntroStars.astro';
import SectionRegis from '../components/SectionRegis.astro';
import ArrowTop from '../components/ArrowTop.astro';
import FAQ from '../components/FAQ.astro';
import ContactSection from '../components/ContactSection.astro';
---

<MainLayout title="&Hacks 2026">
  
  <ParticleBG />

  <main style="position: relative; overflow-x: hidden;">
    <section id="hero">
      <div class="hero-title">
        <h1>&amp;Hacks 2026</h1>
        <p>Sept. 25–27</p>
      </div>

      <Andy />
      <BGclouds />

    </section>
    
    <SectionIntro />
    <!-- <IntroStars /> -->

    <SectionRegis />
    <FAQ />
    <ContactSection />
  </main>

  <ArrowTop />

</MainLayout>

<style>
  #hero {
    position: relative;
    height: 100vh;
    width: 100%;
  }

  .hero-title {
    position: absolute;
    top: 5rem;
    left: 12rem;
    z-index: 5;
  }

  h1 {
    font-size: clamp(4rem, 9vw, 8rem);
    font-weight: 900;
    margin: 0;
    line-height: 1;
  }

  .hero-title p {
    font-size: 2.5rem;
    margin: 0.5rem 0 0 0;
    opacity: 0.8;
  }

  .hero-title h1 {
  font-family: 'Pacifico', cursive;
  }
</style>